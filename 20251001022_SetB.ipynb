A = 2.0
B = 1.0
C = 0.0
# Read equilibrium constant
raw_input = input("Enter Kc:")
print("raw_input:", raw_input)
print("type(raw_input):", type(raw_input))  

try:
    Kc = float(raw_input)
    print("Kc:", Kc)
    print("type(Kc):", type(Kc))
    if Kc <= 0:
        print("Error: Kc must be a positive number.")
    # Solve the quadratic equation Ax^2 + Bx + C = 0
    A = Kc
    B = -(3 * Kc + 1)
    C = 2 * Kc
    discriminant = B**2 - 4*A*C
    if discriminant < 0:
        print("Error: No real solution exists for the given Kc.")
    if discriminant >= 0:
        x = -B / (2*A)
        print("The solution is:", x)
    else:
        x1 = (-B + discriminant**0.5) / (2*A)
        x2 = (-B - discriminant**0.5) / (2*A)
        print("The solutions are:", x1, "and", x2)      
    # Select the physically meaningful solution (x must be between 0 and A0)
    if 0 <= x1 <= 1:
        print("The physically meaningful solution is:", x1)
    elif 0 <= x2 <= 1:
        print("The physically meaningful solution is:", x2)
    except ValueError:
    print("Error: Invalid input. Please enter a numeric value for Kc.")
